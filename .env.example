# ============================================
# DEPLOYMENT MODE
# ============================================
# Set to 'false' to use real Supabase database (PRODUCTION MODE)
# Set to 'true' or leave empty for local development with mock data
VITE_USE_MOCK_MODE=true

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
# Get these from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe Webhook Secret
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs
# Create products in Stripe Dashboard and copy the Price IDs
VITE_STRIPE_STARTER_PRICE_ID=price_starter_id
VITE_STRIPE_PROFESSIONAL_PRICE_ID=price_professional_id
VITE_STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_id

# Application URL
VITE_APP_URL=http://localhost:5173

# Email Service (Resend - for email notifications)
# Get your API key from: https://resend.com/api-keys
VITE_RESEND_API_KEY=your_resend_api_key_here
VITE_FROM_EMAIL=noreply@careconnectpro.com
VITE_SUPPORT_EMAIL=support@careconnectpro.com

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production:
# [ ] Set VITE_USE_MOCK_MODE=false
# [ ] Add your Supabase URL and anon key
# [ ] Run supabase-trial-subscription-schema.sql in Supabase SQL Editor
# [ ] Replace all Stripe "test" keys with "live" keys
# [ ] Update VITE_APP_URL to your production domain
# [ ] Configure email service (Resend)
# [ ] Enable HTTPS for all endpoints
# [ ] Test signup flow end-to-end
# [ ] Set up automated jobs for trial expiration
# [ ] Never commit .env file to version control!

# ============================================
# QUICK START FOR PRODUCTION
# ============================================
# 1. Copy this file to .env
# 2. Set VITE_USE_MOCK_MODE=false
# 3. Fill in your Supabase credentials
# 4. Run: npm install
# 5. Run: npm run dev
# 6. Test signup at http://localhost:5173
# 7. Deploy to Vercel and add same env variables
#
# For detailed instructions, see: PRODUCTION_SETUP_GUIDE.md
