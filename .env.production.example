# ============================================================================
# CARE CONNECT PRO - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to version control!
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (NEVER expose to frontend - backend/Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Disable mock mode for production
VITE_USE_MOCK_MODE=false

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Secret key (backend only - for Edge Functions)
STRIPE_SECRET_KEY=sk_live_your_secret_key

# Webhook secret (from Stripe webhook settings)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (from Stripe Products & Prices)
VITE_STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
VITE_STRIPE_PRICE_STARTER_ANNUAL=price_starter_annual
VITE_STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
VITE_STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly
VITE_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_enterprise_annual

# ============================================================================
# EMAIL SERVICE (Choose one)
# ============================================================================
# Option 1: Resend (recommended for simplicity)
RESEND_API_KEY=re_your_resend_api_key
VITE_EMAIL_FROM=notifications@your-domain.com

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# VITE_EMAIL_FROM=notifications@your-domain.com

# Option 3: AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your_access_key
# AWS_SES_SECRET_ACCESS_KEY=your_secret_key
# VITE_EMAIL_FROM=notifications@your-domain.com

# ============================================================================
# SMS SERVICE (Optional - for notifications)
# ============================================================================
# Twilio (for SMS notifications and MFA)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry (Error tracking)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=care-connect-pro
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# LogDNA / Better Stack (Log management)
LOGDNA_INGESTION_KEY=your_logdna_key

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================
# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# PostHog (Product analytics)
VITE_POSTHOG_KEY=phc_your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# FILE STORAGE
# ============================================================================
# Supabase Storage bucket names
VITE_SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
VITE_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
VITE_SUPABASE_STORAGE_BUCKET_EXPORTS=exports

# Max file upload size (in MB)
VITE_MAX_FILE_SIZE_MB=10

# ============================================================================
# SECURITY & COMPLIANCE
# ============================================================================
# Encryption key for sensitive data (PHI/PII)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Session configuration
SESSION_SECRET=your-session-secret-key-minimum-32-chars
SESSION_MAX_AGE=604800 # 7 days in seconds

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000 # 1 minute

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://www.your-domain.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application URLs
VITE_APP_URL=https://app.your-domain.com
VITE_MARKETING_URL=https://www.your-domain.com
VITE_API_URL=https://your-project-ref.supabase.co

# Application name & branding
VITE_APP_NAME=Care Connect Pro
VITE_SUPPORT_EMAIL=support@your-domain.com
VITE_SUPPORT_PHONE=+1-800-XXX-XXXX

# Feature flags
VITE_ENABLE_MFA=true
VITE_ENABLE_FAMILY_PORTAL=true
VITE_ENABLE_EVV=true
VITE_ENABLE_BILLING=true
VITE_ENABLE_ANALYTICS=true

# ============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ============================================================================
# Google Maps API (for address autocomplete, EVV location)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OpenAI (for AI features - optional)
OPENAI_API_KEY=sk-your_openai_api_key

# Zapier (for workflow automation - optional)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxx/xxx

# ============================================================================
# CRON JOB CONFIGURATION
# ============================================================================
# These are used by scheduled jobs (Supabase pg_cron or external)
CRON_SECRET_KEY=your-cron-secret-for-authentication

# Schedule for automated tasks
CRON_TRIAL_EXPIRY_CHECK=0 2 * * * # Daily at 2 AM
CRON_SUBSCRIPTION_RENEWAL=0 0 1 * * # Monthly on 1st at midnight
CRON_USAGE_METRICS_UPDATE=0 */6 * * * # Every 6 hours
CRON_BACKUP_DATABASE=0 3 * * * # Daily at 3 AM

# ============================================================================
# DEPLOYMENT & CI/CD
# ============================================================================
# Vercel
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# GitHub (for CI/CD)
GITHUB_TOKEN=your_github_token

# Environment
NODE_ENV=production
VITE_ENVIRONMENT=production

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
# AWS S3 (for backups)
AWS_S3_BACKUP_BUCKET=care-connect-pro-backups
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ============================================================================
# COMPLIANCE & HIPAA
# ============================================================================
# PHI encryption at rest
ENABLE_PHI_ENCRYPTION=true

# Audit logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years for HIPAA compliance

# Access logging
ENABLE_ACCESS_LOGGING=true
ACCESS_LOG_RETENTION_DAYS=90

# ============================================================================
# NOTES
# ============================================================================
# 1. All VITE_ prefixed variables are exposed to the frontend
# 2. Never commit this file with real values to version control
# 3. Use different keys/secrets for staging and production
# 4. Rotate secrets regularly (at least annually)
# 5. Use environment-specific Stripe keys (test vs live)
# 6. Ensure HTTPS is enabled in production
# 7. Configure Supabase RLS policies before going live
# 8. Set up monitoring and alerting before launch
# 9. Test backup and restore procedures
# 10. Review and update CORS settings for production domains
